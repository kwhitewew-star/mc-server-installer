#!/usr/bin/env python3
"""Fake java: mimics -version, installers (--installServer, quilt install) and a running server."""
import os
import sys

args = sys.argv[1:]
if args == ["-version"]:
    sys.stderr.write('openjdk version "25.0.1" 2025-10-21 LTS\nOpenJDK Runtime Environment Temurin-25.0.1+8 (build 25.0.1+8-LTS)\n')
    sys.exit(0)
if "--installServer" in args:
    jar = args[args.index("-jar") + 1]
    ver = jar.replace("-installer.jar", "").split("-", 1)[1]
    group = "net/neoforged/neoforge" if jar.startswith("neoforge") else "net/minecraftforge/forge"
    print(f"Installing {jar} ...")
    base = f"libraries/{group}/{ver}"
    os.makedirs(base, exist_ok=True)
    open(f"{base}/win_args.txt", "w").write("-cp x\n")
    open(f"{base}/unix_args.txt", "w").write("-cp x\n")
    open("run.bat", "w").write(f"java @user_jvm_args.txt @{base.replace('/', chr(92))}\\win_args.txt %*\npause\n")
    open("run.sh", "w").write(f"java @user_jvm_args.txt @{base}/unix_args.txt \"$@\"\n")
    print("The server installed successfully")
    sys.exit(0)
if "install" in args and "server" in args:
    d = [a for a in args if a.startswith("--install-dir=")][0].split("=", 1)[1]
    open(os.path.join(d, "quilt-server-launch.jar"), "w").write("x")
    open(os.path.join(d, "server.jar"), "w").write("x")
    print("Installed quilt server")
    sys.exit(0)
if "--rev" in args:
    out = args[args.index("--output-dir") + 1]
    rev = args[args.index("--rev") + 1]
    name = "craftbukkit" if "craftbukkit" in args else "spigot"
    print("BuildTools building", name, rev)
    open(os.path.join(out, f"{name}-{rev}.jar"), "w").write("x")
    sys.exit(0)
# running server
if os.environ.get("FAKE_FAIL") == "javaver":
    print("Error: LinkageError occurred while loading main class net.minecraft.server.Main")
    print("java.lang.UnsupportedClassVersionError: compiled by a more recent version")
    sys.exit(1)
print("[Server thread/INFO]: Starting minecraft server version 26.3")
print("[Server thread/INFO]: Preparing level \"world\"")
print("[Server thread/INFO]: Done (3.141s)! For help, type \"help\"", flush=True)
for line in sys.stdin:
    c = line.strip()
    if c.startswith("gamerule "):
        _, n, v = c.split()
        if n in ("doFireTick",):
            print("Unknown or incomplete command, see below for error")
        else:
            print(f"[Server thread/INFO]: Gamerule {n} is now set to: {v}")
    elif c.startswith("op "):
        print(f"[Server thread/INFO]: Made {c[3:]} a server operator")
    elif c.startswith("whitelist add "):
        print(f"[Server thread/INFO]: Added {c[14:]} to the whitelist")
    elif c == "save-all":
        print("[Server thread/INFO]: Saved the game")
    elif c == "stop":
        print("[Server thread/INFO]: Stopping the server")
        os.makedirs("world", exist_ok=True)
        sys.exit(0)
    sys.stdout.flush()
